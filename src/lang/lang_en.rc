/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_CFGPAGEVIEWER DIALOGEX 66, 53, 220, 130
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "SQLite Viewer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Window Position",IDC_STATIC_1,4,4,212,38
    CONTROL         "&Save on close",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,11,14,75,10
    CONTROL         "S&et to position of Salamander's window",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,11,26,170,10

    GROUPBOX        "Display & Performance",IDC_STATIC_2,4,46,212,78
    LTEXT           "Default page si&ze:",IDC_STATIC_3,11,58,70,8
    COMBOBOX        IDC_CFG_PAGESIZE,85,56,60,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Max &query rows:",IDC_STATIC_4,11,74,70,8
    EDITTEXT        IDC_CFG_ROWCAP,85,72,60,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Default &view:",IDC_STATIC_5,11,90,70,8
    COMBOBOX        IDC_CFG_DEFAULTVIEW,85,88,85,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Directly open local files (read-only snapshot)",IDC_CFG_DIRECTOPEN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,106,195,10
END

